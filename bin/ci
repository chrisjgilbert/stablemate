#!/usr/bin/env bash
# Stablemate CI — the single source of truth for "is this green?".
# Run locally (the pre-push hook calls this) and in GitHub Actions, so local and
# remote CI are identical. Defensive: the repo starts as docs only, so when the
# app isn't scaffolded yet this exits 0 instead of failing.
#
# Usage: bin/ci [--fast]
#   --fast  Skip rails test:system (the slow, browser-driven suite). Used by
#           the local pre-push hook so `git push` stays quick; GitHub Actions
#           always runs the full suite (system tests included), and that's the
#           check required to be green before merging.
set -uo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
step() { printf '\n\033[1m→ %s\033[0m\n' "$*"; }

fail=0
note_fail() { fail=1; printf '\033[31m✗ %s failed\033[0m\n' "$1"; }

fast=0
[ "${1:-}" = "--fast" ] && fast=1

# --- Nothing to do until the app exists ------------------------------------
if [ ! -f Gemfile ]; then
  bold "bin/ci: no Gemfile yet — app not scaffolded. Nothing to check. ✓"
  exit 0
fi

bold "== Stablemate CI =="

# --- Dependencies ----------------------------------------------------------
if command -v bundle >/dev/null 2>&1; then
  step "bundle install"
  bundle check >/dev/null 2>&1 || bundle install || { echo "bundle install failed"; exit 1; }
fi

# --- Prepare the test database --------------------------------------------
if [ -f bin/rails ]; then
  step "db:prepare (RAILS_ENV=test)"
  RAILS_ENV=test bin/rails db:prepare || { echo "db:prepare failed"; exit 1; }
fi

# --- Lint ------------------------------------------------------------------
# Prefer the committed bin/ binstub over `bundle exec`: in some sandboxes a
# Bundler binstub quirk makes `bundle exec <tool>` exit non-zero, which silently
# skipped these steps (a false-green gate). The binstubs work everywhere (and are
# tracked, so CI has them); `bundle exec` stays as a fallback. Mirrors the direct
# invocation already used for the gem suite below.
if [ -x bin/rubocop ]; then
  step "rubocop"
  bin/rubocop || note_fail "rubocop"
elif bundle exec rubocop --version >/dev/null 2>&1; then
  step "rubocop"
  bundle exec rubocop || note_fail "rubocop"
fi

# --- Security --------------------------------------------------------------
if [ -x bin/brakeman ]; then
  step "brakeman"
  bin/brakeman --quiet --no-pager -w2 || note_fail "brakeman"
elif bundle exec brakeman --version >/dev/null 2>&1; then
  step "brakeman"
  bundle exec brakeman --quiet --no-pager -w2 || note_fail "brakeman"
fi
if [ -x bin/bundler-audit ] || bundle exec bundle-audit version >/dev/null 2>&1; then
  step "bundle-audit"
  # No ignores. GHSA-mjgf-xj26-9qf9 (Pay's Paddle HMAC compare) was carried here
  # while we were pinned to pay 8.3; pay 11 is on the patched line, so the
  # advisory is gone rather than excused. Keep this list empty — an ignored
  # advisory on the billing path is exactly the thing that rots quietly.
  if [ -x bin/bundler-audit ]; then
    bin/bundler-audit check --update || note_fail "bundle-audit"
  else
    bundle exec bundle-audit check --update || note_fail "bundle-audit"
  fi
fi

# --- Tests -----------------------------------------------------------------
if [ -f bin/rails ]; then
  step "rails test (unit + request + job + mailer)"
  bin/rails test || note_fail "rails test"

  if [ "$fast" -eq 1 ]; then
    printf '\n→ rails test:system skipped (--fast) — runs in full in GitHub Actions before merge.\n'
  else
    step "rails test:system (browser-driven, mandatory in full CI)"
    bin/rails test:system || note_fail "rails test:system"
  fi
fi

# --- Companion gem suite ---------------------------------------------------
# Runs the gem's own Minitest suite when gem/ is present (skipped only when the
# directory doesn't exist). The gem suite is a REQUIRED part of the gate and
# fails CLOSED: if the gem's deps can't be installed, `require "fugit"` raises
# and the run red-fails here — we never want to silently skip the gem suite. So
# a real gem test failure OR a gem dependency failure fails CI. Invoked directly
# via ruby (not `bundle exec rake`) so it's independent of the app's Bundler and
# of the Bundler 4 binstub quirk that hides bundled executables in this sandbox.
if [ -d gem ]; then
  step "stablemate gem tests"
  (
    cd gem
    # Ask whether the suite's dependencies LOAD, rather than whether the gem has
    # its own installed bundle. It runs on the plain load path (no `bundle
    # exec`), and every one of these already ships in the app's bundle — fugit
    # via solid_queue, the rest via rails — so on CI they are present the moment
    # setup-ruby restores its cache.
    #
    # `bundle check` could never answer yes here: gem/Gemfile.lock is gitignored,
    # so it failed on every CI run and fell through to a full `bundle install`,
    # resolving and downloading against rubygems.org outside setup-ruby's cache
    # (which is keyed on the APP's Gemfile.lock). Measured from the Actions logs,
    # that was ~26-28s of a ~110s bin/ci step — more than `rails test` and more
    # than `rails test:system`, spent re-fetching gems already on disk.
    #
    # Still fails CLOSED: if the probe fails we install, and if that install
    # fails the ruby run below raises on the missing dependency and reds the run.
    # The gem suite is never silently skipped.
    if ! ruby -e 'require "fugit"; require "minitest/autorun"; require "active_support"; require "active_job"' >/dev/null 2>&1; then
      bundle install >/dev/null 2>&1 || true
    fi
    ruby -Ilib -Itest -e 'Dir["test/**/*_test.rb"].each { |f| require File.expand_path(f) }'
  ) || note_fail "gem tests"
fi

echo
if [ "$fail" -ne 0 ]; then
  bold "== CI FAILED =="
  exit 1
fi
bold "== CI PASSED =="
