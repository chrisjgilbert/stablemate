<%#
  Shows a raw sm_… key exactly once; it is never re-rendered after this. Only a
  SHA-256 digest and the last 4 characters are stored, so nothing CAN re-display
  it — the remedy for a lost key is to generate another and revoke this one.

  Locals: raw_token, label ("API key" / "Ping key").
%>
<% slug = label.parameterize %>
<div data-controller="dialog" data-dialog-open-value="true">
  <div data-dialog-target="backdrop" data-action="click->dialog#backdropClick"
       class="fixed inset-0 z-40 bg-black/30 flex items-center justify-center p-4">
    <div class="w-full max-w-md rounded-2xl bg-surface shadow-xl border border-border p-6 space-y-4"
         role="dialog" aria-modal="true" aria-label="New <%= label %>" data-testid="<%= slug %>-modal">
      <h2 class="font-display text-lg font-bold tracking-tight">Your new <%= label %></h2>

      <div class="rounded-lg border border-pending-dot bg-pending-bg px-4 py-2.5 text-[13px] text-pending-text"
           data-testid="<%= slug %>-warning">
        Copy this key now — you won't see it again.
      </div>

      <%= render "shared/copyable", value: raw_token, dark: true, label: label %>

      <div class="flex justify-end pt-1">
        <button type="button" data-action="dialog#close"
                class="h-9 px-4 rounded-lg bg-brand text-white text-[13px] font-semibold hover:bg-brand-hover">
          Done
        </button>
      </div>
    </div>
  </div>
</div>
