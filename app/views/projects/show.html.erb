<% content_for :title, @project.name %>

<div class="flex items-center justify-between mb-6">
  <div class="flex items-center gap-3 min-w-0">
    <%= link_to "Projects", projects_path, class: "text-[13px] text-muted hover:text-ink shrink-0" %>
    <span class="text-muted shrink-0">/</span>
    <h1 class="font-display text-xl font-bold tracking-tight truncate"><%= @project.name %></h1>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <%= link_to "New monitor", new_monitor_path(monitor: { project_id: @project.id }),
          class: "inline-flex items-center h-8 px-3 rounded-lg bg-brand text-white text-[13px] font-semibold hover:bg-brand-hover" %>
    <%= link_to "Settings", edit_project_path(@project),
          class: "inline-flex items-center h-8 px-3 rounded-lg border border-border text-[13px] font-semibold text-secondary hover:bg-hairline" %>
  </div>
</div>

<%# Subscribed so Project::MonitorSync can flip the milestone ladder the moment a
    deploy registers monitors — the page a user is watching while the terminal
    does the work. %>
<%= turbo_stream_from @project %>

<% if @monitors.any? %>
  <%= render "monitors/list", monitors: @monitors, mini_ticks: @mini_ticks %>
<% end %>

<%# The setup panel replaces "Add one manually" (v1-scope §7): monitors come
    from the repo now, so an empty project is not missing a button — it is
    waiting for a deploy. It stays visible while the project is still waiting on
    its first check-in, because that is exactly when the user needs the ladder. %>
<%# @setup_pair FIRST, and it is not a nicety: it is the only render that will
    ever show these keys. A check-in landing between the page load and the
    regenerate click flips both ladder predicates false, and without this the
    panel would be omitted from the very response that carries the pair — after
    the superseded one had already been destroyed. Live credentials nobody has
    ever seen. %>
<% if @setup_pair || @project.awaiting_first_sync? || @project.awaiting_first_check_in? %>
  <div class="<%= "mt-6" if @monitors.any? %>">
    <%= render "projects/setup_panel", project: @project, setup_pair: @setup_pair,
          api_keys: @api_keys, ping_keys: @ping_keys %>
  </div>
<% end %>

<%= render "projects/keys", project: @project, keys: @ping_keys, key_class: PingKey,
      slug: "ping-keys", heading: "Ping keys", generate_label: "Generate ping key",
      blurb: "The credential your jobs check in with. Rotate by generating a second key, deploying it, then revoking the first.",
      empty_text: "No ping keys yet. Generate one so this app's jobs can check in.",
      revoke_warning: "Revoke this key? Any job still checking in with it stops being monitored." %>

<%= render "projects/keys", project: @project, keys: @api_keys, key_class: ApiKey,
      slug: "api-keys", heading: "API keys", generate_label: "Generate key",
      blurb: "Drop a key into this app's Stablemate gem to sync its monitors here, or to call the API.",
      empty_text: "No API keys yet. Generate one to connect this app's gem or call the API.",
      revoke_warning: "Revoke this key? Anything using it stops working immediately." %>

<% if @raw_token.present? %>
  <%= render "projects/generated_modal", raw_token: @raw_token, label: @raw_token_label %>
<% end %>
